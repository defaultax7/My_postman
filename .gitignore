# Postman Replicate - source only; generated/local files are ignored.

# Desktop runtime directory (linked or copied Electron runtime, created by
# tools/make-runtime.js on first launch).
/runtime/

# Remembered runtime mode (link|copy) written by tools/make-runtime.js
/.runtime-mode

# App data: collections, environments, globals, history, settings, cookies.
# Deleting this folder resets the app.
/data/

# Electron/Chromium profile (cache, cookies, session) created by the shell.
/userdata/

# Logs and crash dumps
*.log
npm-debug.log*
yarn-error.log*
Crashpad/

# Dependencies (the app itself has none; kept for safety)
/node_modules/

# Generated Windows packages
/dist/

# OS / editor junk
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/
